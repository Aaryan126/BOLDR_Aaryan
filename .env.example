# BOLDR Revenue Rocket local development settings

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database
POSTGRES_DB=boldr_revenue_rocket
POSTGRES_USER=boldr
POSTGRES_PASSWORD=boldr_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://boldr:boldr_dev_password@localhost:5432/boldr_revenue_rocket

# Qwen / Alibaba Cloud Model Studio
# Not required for Phase 1. Keep blank until Phase 5.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
