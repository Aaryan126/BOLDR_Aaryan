# BOLDR SignalDesk local development settings

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database
POSTGRES_DB=boldr_signaldesk
POSTGRES_USER=boldr
POSTGRES_PASSWORD=boldr_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://boldr:boldr_dev_password@localhost:5432/boldr_signaldesk

# GLM-5.1 / FPT AI Factory
# Not required for local tests. Keep AI_LIVE_ENABLED=false unless you are intentionally
# smoke-testing live inference.
AI_PROVIDER=fpt_ai_factory
FPT_AI_API_KEY=
FPT_AI_BASE_URL=https://mkp-api.fptcloud.com/v1
GLM_MODEL=GLM-5.1
GLM_THINKING_ENABLED=false
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_LIVE_ENABLED=false
AI_DETERMINISTIC_FALLBACK_ENABLED=false

# Public demo guardrail
PUBLIC_ENQUIRY_RATE_LIMIT=30
PUBLIC_ENQUIRY_RATE_WINDOW_SECONDS=60
